# Copy to .env and fill in. Never commit .env.

# Authentication: by default the sidecar uses your Claude Code login, the same
# claude.ai subscription credentials the `claude` CLI uses in a terminal. Sign in
# with `claude auth login`, then confirm with `npm run check-auth`.
# Only set ANTHROPIC_API_KEY if you want per-token API billing instead; it takes precedence.
# ANTHROPIC_API_KEY=

# Model and thinking effort for voice turns. Low effort is the fastest; raise it
# when you want deeper work. claude-sonnet-5 is the faster alternative model.
CLICKY_AGENT_MODEL=claude-opus-5-5
CLICKY_AGENT_EFFORT=low

# Absolute path of the project the agent should work in when you talk to it.
CLICKY_PROJECT_DIRECTORY=/Users/you/code/your-project

# Localhost port the Swift app connects to.
CLICKY_SIDECAR_PORT=47821

# Optional shared secret the Swift app must present on connect. Leave empty to disable in dev.
CLICKY_SIDECAR_TOKEN=
